# Copia este archivo como .env y completa GEMINI_API_KEY (no subas .env a GitHub)
POSTGRES_USER=rag
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=constitucion_rag

# Clave gratuita de Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# Modelo generativo. Los disponibles dependen de tu clave:
#   docker compose run --rm app python -m src.probar_modelos
GEMINI_MODEL=gemini-3.1-flash-lite

# Puerto de PostgreSQL visible desde tu maquina (cambialo si el 5432 esta ocupado)
# POSTGRES_PORT=5432